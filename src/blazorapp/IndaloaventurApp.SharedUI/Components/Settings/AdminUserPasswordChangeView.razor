@using IndaloaventurApp.SharedUI.Resources
@using Microsoft.AspNetCore.Components.Forms

<section class="settings-admin-password">
    <header class="settings-admin-password__header">
        <nav class="settings-admin-password__breadcrumb" aria-label="@L["settings_admin_password_breadcrumb_label"]">
            <a class="settings-admin-password__breadcrumb-link" href="/mi-cuenta">@L["shell_nav_my_account"]</a>
            <span class="settings-admin-password__breadcrumb-separator" aria-hidden="true">/</span>
            <a class="settings-admin-password__breadcrumb-link" href="/configuracion">@L["settings_title"]</a>
            <span class="settings-admin-password__breadcrumb-separator" aria-hidden="true">/</span>
            <a class="settings-admin-password__breadcrumb-link" href="/configuracion/usuarios">@L["settings_users_title"]</a>
            <span class="settings-admin-password__breadcrumb-separator" aria-hidden="true">/</span>
            <a class="settings-admin-password__breadcrumb-link" href="@($"/configuracion/usuarios/{UserId}/ficha")">@L["settings_admin_member_file_title"]</a>
            <span class="settings-admin-password__breadcrumb-separator" aria-hidden="true">/</span>
            <span class="settings-admin-password__breadcrumb-current" aria-current="page">@L["settings_admin_password_title"]</span>
        </nav>

        <div class="settings-admin-password__hero card border border-base-200 bg-base-100 shadow-sm">
            <div class="card-body">
                <div class="settings-admin-password__hero-topline">
                    <p class="settings-admin-password__eyebrow">@L["settings_admin_title"]</p>
                    <span class="badge badge-outline settings-admin-password__badge">@L["settings_admin_member_file_badge"]</span>
                </div>
                <h1>@L["settings_admin_password_title"]</h1>
                <p>@L["settings_admin_password_summary"]</p>
            </div>
        </div>
    </header>

    @if (IsLoading)
    {
        <div class="alert settings-admin-password__status" role="status">
            <span class="loading loading-spinner loading-sm" aria-hidden="true"></span>
            <span>@L["settings_admin_password_loading"]</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessageKey))
    {
        <div class="alert alert-error settings-admin-password__status" role="alert">
            <span>@L[ErrorMessageKey]</span>
        </div>
    }
    else if (ManagedUser is not null)
    {
        @if (!string.IsNullOrWhiteSpace(StatusMessageKey))
        {
            <div class="alert alert-success settings-admin-password__status" role="status">
                <span>@L[StatusMessageKey]</span>
            </div>
        }

        <fieldset class="fieldset card border border-base-200 bg-base-100 shadow-sm settings-admin-password__fieldset" aria-label="@L["settings_admin_password_title"]">
            <legend class="fieldset-legend settings-admin-password__legend">@L["settings_admin_password_form_title"]</legend>

            <div class="card-body">
                <div class="settings-admin-password__target">
                    <span class="settings-admin-password__target-label">@L["settings_admin_password_target_label"]</span>
                    <strong>@TargetDisplayName</strong>
                    <small>@ManagedUser.Email</small>
                </div>

                <EditForm Model="Form" OnValidSubmit="HandleValidSubmitAsync" class="settings-admin-password__form">
                    <DataAnnotationsValidator />

                    <div class="form-control settings-admin-password__field">
                        <label class="label" for="admin-user-new-password">
                            <span class="label-text">@L["settings_admin_password_new_label"]</span>
                        </label>
                        <InputText id="admin-user-new-password"
                                   class="input input-bordered w-full"
                                   type="password"
                                   autocomplete="new-password"
                                   maxlength="20"
                                   pattern="[A-Za-z0-9]+"
                                   @bind-Value="Form.NewPassword" />
                        <p class="settings-admin-password__hint">@L["settings_admin_password_hint"]</p>
                        <ValidationMessage For="() => Form.NewPassword" />
                    </div>

                    <div class="settings-admin-password__actions">
                        <a class="btn btn-outline" href="@($"/configuracion/usuarios/{UserId}/ficha")">@L["settings_admin_password_cancel"]</a>
                        <button type="submit" class="btn btn-primary settings-admin-password__submit" disabled="@IsSubmitting">
                            @L["settings_admin_password_submit"]
                        </button>
                    </div>
                </EditForm>
            </div>
        </fieldset>
    }
</section>
